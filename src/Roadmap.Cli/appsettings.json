{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Roadmap": "Information"
    }
  },
  "Agent": {
    "Provider": "OpenAICompatible",
    "CheckLinks": true,
    "OpenAICompatible": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
      "Model": "gemini-3.8-flash",
      "FallbackModels": [ "gemini-3.6-flash", "gemini-3.5-flash", "gemini-3.1-flash-lite" ],
      "FallbackAfterSeconds": 90,
      "MaxOutputTokens": 32000,
      "ReasoningEffort": "low"
    },
    "Tavily": {
      "MaxResultsPerQuery": 5
    },
    "Claude": {
      "Model": "claude-opus-5-5",
      "Effort": "medium",
      "MaxSearches": 6,
      "UseServerFallbacks": true
    }
  }
}
